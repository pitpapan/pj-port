menuconfig VOIP_FACADE
	bool "PJPROJECT VoIP C++ facade"
	depends on CPP
	default n
	help
	  Build the application-facing VoIP contract. The Phase 1 backend is a
	  deterministic fake and does not initialize or link PJPROJECT.

if VOIP_FACADE

config VOIP_FAKE_BACKEND
	bool "VoIP facade fake backend"
	default n
	help
	  Build the bounded Phase 1 lifecycle backend used by facade tests.

config VOIP_PJ_BACKEND
	bool "VoIP PJPROJECT runtime backend"
	depends on PJPROJECT && PJLIB_UTIL && PJSIP && PJSIP_TCP_TRANSPORT
	depends on PJMEDIA_ENDPOINT
	default n
	help
	  Build the shared PJLIB/PJSIP/PJMEDIA runtime owner. Account, call, and
	  media-session behavior is introduced by later integration phases.

config VOIP_PJ_REGISTRATION_NETWORK
	bool "VoIP PJSIP network registration"
	depends on VOIP_PJ_BACKEND && PJSIP_REGC && PJSIP_TCP_TRANSPORT
	default n
	help
	  Enable REGISTER, Digest authentication, automatic refresh, unregister,
	  and bounded reconnect through the PJPROJECT registration client.

config VOIP_PJ_CALL_CONTROL
	bool "VoIP PJSIP one-call control"
	depends on VOIP_PJ_BACKEND && VOIP_PJ_REGISTRATION_NETWORK
	depends on PJSIP_INVITE && PJMEDIA_SDP_NEG
	default n
	help
	  Enable one PJSIP dialog/INVITE session over SIP TCP. Media negotiation is
	  limited to PCMU/PCMA SDP; RTP and audio remain disabled.

config VOIP_PJ_HEADLESS_MEDIA
	bool "VoIP PJMEDIA headless G.711 media"
	depends on VOIP_PJ_BACKEND && PJMEDIA_G711 && PJMEDIA_RTP_RTCP
	depends on PJMEDIA_UDP_TRANSPORT && PJMEDIA_STREAM
	default n
	help
	  Enable generated 8 kHz mono PCM, PCMU/PCMA RTP over UDP, jitter
	  buffering, and a bounded memory sink without an audio device.

config VOIP_PJ_SRTP_KEY_LIFECYCLE
	bool "VoIP per-call SRTP key lifecycle"
	depends on VOIP_PJ_HEADLESS_MEDIA && PJMEDIA_SRTP_SDES
	default n
	help
	  Generate two distinct 30-byte AES-CM master-key/salt values from the
	  Zephyr cryptographically secure random API for every prepared call and
	  explicitly erase them at call teardown. This gate establishes key
	  ownership only; SIP SDP and the facade media transport are not secured
	  until the subsequent SRTP call-path integration is enabled.

config VOIP_PJ_SRTP_MEDIA
	bool "VoIP PJMEDIA SRTP headless media"
	depends on VOIP_PJ_SRTP_KEY_LIFECYCLE && PJMEDIA_SRTP_TRANSPORT
	default n
	help
	  Wrap the facade-owned RTP/UDP transports with PJMEDIA's mandatory SRTP
	  adapter and install the per-call AES_CM_128_HMAC_SHA1_80 keys. This gate
	  secures the media packets but does not yet signal keys through SIP/SDES.

config VOIP_PJ_SRTP_SIGNALING
	bool "VoIP mandatory SRTP/SDES call signaling"
	depends on VOIP_PJ_SRTP_MEDIA && VOIP_PJ_CALL_CONTROL
	depends on PJMEDIA_SRTP_SDES
	default n
	help
	  Route PJSIP INVITE offer/answer through PJMEDIA's strict SDES hooks,
	  require RTP/SAVP, and bind the negotiated policies to the facade-owned
	  SRTP transports. SDES reveals keys to signaling, so production use also
	  requires authenticated SIP TLS.

endif

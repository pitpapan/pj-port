menuconfig PJPROJECT
	bool "PJPROJECT"
	help
	  Enable PJPROJECT components for Zephyr applications.

if PJPROJECT

config PJLIB
	bool "PJLIB"
	help
	  Enable the PJLIB base library.

config PJLIB_UTIL
	bool "PJLIB-UTIL"
	depends on PJLIB
	help
	  Enable the PJLIB-UTIL facilities selected for Zephyr. The source list is
	  intentionally explicit and grows only when a consumer requires another
	  facility.

config PJLIB_UTIL_DNS_RESOLVER
	bool "PJLIB-UTIL asynchronous DNS and SRV resolver"
	depends on PJLIB_UTIL && NET_SOCKETS && NET_IPV4 && NET_UDP
	help
	  Compile the PJLIB-UTIL DNS packet, asynchronous resolver, and SRV
	  resolver sources. IPv6 and DNS NAPTR remain outside this feature.

menuconfig PJMEDIA
	bool "PJMEDIA"
	depends on PJLIB_UTIL
	help
	  Enable the PJMEDIA configuration and public-header boundary. Production
	  source families remain independently selectable and are introduced only
	  after their port phase validates their complete link closure.

if PJMEDIA

config PJMEDIA_SDP
	bool "PJMEDIA SDP representation and parser"
	depends on PJMEDIA
	help
	  Select the SDP representation, parser, printer, and comparison boundary.
	  The Zephyr profile also rejects malformed line endings, oversized input,
	  and data beyond its configured SDP array limits.

config PJMEDIA_SDP_NEG
	bool "PJMEDIA SDP offer/answer negotiation"
	depends on PJMEDIA_SDP
	help
	  Select SDP negotiation and its audited codec/stream helper closure. This
	  does not select a media endpoint, codec implementation, RTP/RTCP,
	  transport, stream runtime, or audio device.

config PJMEDIA_ENDPOINT
	bool "PJMEDIA endpoint and codec manager"
	depends on PJMEDIA_SDP
	help
	  Select the PJMEDIA endpoint/runtime primitives. The initial runtime will
	  share the existing PJSIP ioqueue and create no PJMEDIA worker threads.

config PJMEDIA_G711
	bool "PJMEDIA G.711 PCMU/PCMA codec"
	depends on PJMEDIA_ENDPOINT
	help
	  Select only the built-in PCMU/PCMA codec family. Other codec families
	  remain disabled by the Zephyr profile.

config PJMEDIA_RTP_RTCP
	bool "PJMEDIA RTP, RTCP, and jitter buffer primitives"
	depends on PJMEDIA_ENDPOINT
	help
	  Select the socket-free RTP/RTCP packet, feedback, session, and adaptive
	  jitter-buffer primitives. This does not select a media transport, stream,
	  SRTP, ICE, or audio device.

config PJMEDIA_LOOP_TRANSPORT
	bool "PJMEDIA loop transport"
	depends on PJMEDIA_RTP_RTCP
	help
	  Select the socket-free PJMEDIA loop transport used to validate media
	  transport attachment, callbacks, ownership, and teardown independently
	  of network sockets or an audio stream.

config PJMEDIA_UDP_TRANSPORT
	bool "PJMEDIA IPv4 UDP transport"
	depends on PJMEDIA_LOOP_TRANSPORT
	depends on NET_SOCKETS && NET_IPV4 && NET_UDP
	help
	  Select plain IPv4 UDP RTP/RTCP transport. SRTP and ICE are separate,
	  deferred features and are not selected by this option.

config PJMEDIA_STREAM
	bool "PJMEDIA G.711 audio stream"
	depends on PJMEDIA_ENDPOINT && PJMEDIA_G711
	depends on PJMEDIA_RTP_RTCP && PJMEDIA_UDP_TRANSPORT
	help
	  Select one G.711 audio stream over the validated RTP/RTCP UDP boundary.

config PJMEDIA_AUDIODEV
	bool "PJMEDIA audio-device core"
	depends on PJMEDIA_ENDPOINT
	help
	  Select the audio-device abstraction without selecting any backend.

config PJMEDIA_AUDIODEV_NULL
	bool "PJMEDIA null audio device"
	depends on PJMEDIA_AUDIODEV
	help
	  Select the null audio backend for lifecycle validation only. It does not
	  generate capture/playback timing and cannot validate media flow.

config PJMEDIA_AUDIODEV_ZEPHYR
	bool "PJMEDIA Zephyr audio device"
	depends on PJMEDIA_AUDIODEV && AUDIO
	help
	  Select the future Zephyr audio backend. Board, device-tree, codec, clock,
	  and DMA choices remain application/product configuration.

endif # PJMEDIA

config PJSIP
	bool "PJSIP core"
	depends on PJLIB_UTIL
	help
	  Enable the PJSIP signaling core. PJLIB-UTIL and PJLIB must be enabled
	  first. The socket-free loop transport is part of this base component.

config PJSIP_INVITE
	bool "PJSIP INVITE sessions"
	depends on PJSIP && PJMEDIA_SDP_NEG
	help
	  Select INVITE sessions, 100rel, and session timers after SDP negotiation
	  has a validated link closure. This remains disabled during PJMEDIA Phase 1.

if PJSIP

config PJSIP_MAX_TSX_COUNT
	int "Maximum PJSIP transactions"
	range 1 255
	default 31
	help
	  Maximum entries in the transaction hash table. Values of the form
	  2^n-1 avoid upward rounding of the table size.

config PJSIP_MAX_DIALOG_COUNT
	int "Maximum PJSIP dialogs"
	range 1 127
	default 15
	help
	  Maximum entries in the dialog hash table. Values of the form 2^n-1
	  avoid upward rounding of the table size.

config PJSIP_MAX_TRANSPORTS
	int "Maximum PJSIP transports"
	range 1 32
	default 16
	help
	  Maximum transports tracked by PJSIP. The upper bound matches the
	  PJLIB Zephyr ioqueue limit.

config PJSIP_TPMGR_HTABLE_SIZE
	int "PJSIP transport hash table size"
	range 1 255
	default 15
	help
	  Transport manager hash table size. Use a value of the form 2^n-1.

config PJSIP_MAX_MODULE
	int "Maximum PJSIP modules"
	range 1 64
	default 16
	help
	  Maximum modules that may attach per-module data to PJSIP objects.

config PJSIP_MAX_PKT_LEN
	int "Maximum SIP packet length"
	range 512 65535
	default 4000
	help
	  Maximum encoded or received SIP message size in bytes.

config PJSIP_MAX_TIMER_COUNT
	int "Initial PJSIP timer capacity"
	range 16 4096
	default 128
	help
	  Number of timer entries initially allocated by the endpoint timer heap.

config PJSIP_MAX_NET_EVENTS
	int "PJSIP events per ioqueue poll"
	range 1 32
	default 1
	help
	  Maximum ioqueue event batches handled by one endpoint poll. One is the
	  recommended starting value for the select ioqueue backend.

config PJSIP_MAX_TIMED_OUT_ENTRIES
	int "PJSIP timers processed per poll"
	range 1 128
	default 10
	help
	  Maximum expired timer entries handled by one endpoint event poll.

config PJSIP_REGC
	bool "PJSIP registration client"
	depends on PJSIP
	help
	  Compile the independently selectable SIP registration client. This adds
	  pjsip-ua/sip_reg.c only; PJMEDIA, INVITE sessions, PJSUA-LIB, and the
	  remaining PJSIP-UA sources stay disabled.

endif # PJSIP

config PJSIP_UDP_TRANSPORT
	bool "PJSIP UDP transport"
	depends on PJSIP && NET_SOCKETS && NET_IPV4 && NET_UDP
	help
	  Compile the IPv4 UDP SIP transport. Runtime validation belongs to a
	  later porting phase.

config PJSIP_TCP_TRANSPORT
	bool "PJSIP TCP transport"
	depends on PJSIP && NET_SOCKETS && NET_IPV4 && NET_TCP
	help
	  Compile the IPv4 TCP SIP transport. Runtime validation belongs to a
	  later porting phase.

endif # PJPROJECT

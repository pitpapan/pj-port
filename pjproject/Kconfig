menuconfig PJPROJECT
	bool "PJPROJECT"
	help
	  Enable PJPROJECT components for Zephyr applications.

if PJPROJECT

config PJLIB
	bool "PJLIB"
	help
	  Enable the PJLIB base library.

config PJLIB_STAGE5_PROBE
	bool "PJLIB Stage 5 POSIX capability probe"
	depends on !PJLIB
	help
	  Build the isolated compile-time and runtime POSIX capability probe used
	  during PJLIB Zephyr port development.

config PJLIB_STAGE8_TEST
	bool "PJLIB Stage 8 core runtime validation"
	depends on PJLIB
	help
	  Build the repeated PJLIB core runtime validation harness. Networking and
	  ioqueue validation are intentionally excluded and remain in Stage 9.

config PJLIB_STAGE9_TEST
	bool "PJLIB Stage 9 basic networking validation"
	depends on PJLIB
	help
	  Build the loopback socket and resolver validation harness. PJLIB ioqueue
	  readiness and unregister semantics remain deferred to Stage 10.

config PJLIB_STAGE10_TEST
	bool "PJLIB Stage 10 ioqueue validation"
	depends on PJLIB
	help
	  Build the select-backed ioqueue validation harness, including readiness,
	  connect, timeout, concurrency, safe unregister, and handle-limit tests.

endif # PJPROJECT

source "Kconfig.zephyr"

menu "PJLIB minimal application tests"

config PJLIB_STAGE5_PROBE
	bool "PJLIB Stage 5 POSIX capability probe"
	depends on PJPROJECT
	depends on !PJLIB
	help
	  Build the isolated compile-time and runtime POSIX capability probe used
	  during PJLIB Zephyr port development.

config PJLIB_STAGE8_TEST
	bool "PJLIB Stage 8 core runtime validation"
	depends on PJPROJECT && PJLIB
	help
	  Build the repeated PJLIB core runtime validation harness.

config PJLIB_STAGE9_TEST
	bool "PJLIB Stage 9 basic networking validation"
	depends on PJPROJECT && PJLIB
	help
	  Build the loopback socket and resolver validation harness.

config PJLIB_STAGE10_TEST
	bool "PJLIB Stage 10 ioqueue validation"
	depends on PJPROJECT && PJLIB
	help
	  Build the select-backed ioqueue validation harness, including readiness,
	  connect, timeout, concurrency, safe unregister, and handle-limit tests.

endmenu

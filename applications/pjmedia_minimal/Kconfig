source "Kconfig.zephyr"

menu "PJMEDIA minimal application validation"

config PJMEDIA_PHASE1_BOUNDARY_TEST
	bool "PJMEDIA Phase 1 configuration/header boundary"
	depends on PJPROJECT && PJMEDIA && PJMEDIA_G711
	help
	  Compile public configuration headers and assert the initial Zephyr media
	  profile. This test links no PJMEDIA implementation and makes no runtime
	  media claim.

config PJMEDIA_PHASE2_SDP_TEST
	bool "PJMEDIA Phase 2 SDP parser validation"
	depends on PJPROJECT && PJLIB_UTIL && PJMEDIA_SDP
	depends on !PJMEDIA_SDP_NEG && !PJMEDIA_ENDPOINT
	help
	  Run deterministic SDP representation, parse, print, clone, comparison,
	  malformed-input, configured-limit, lifecycle, and resource tests. No
	  negotiation, endpoint, codec, RTP, socket, or audio source is selected.

config PJMEDIA_PHASE3_SDP_NEG_TEST
	bool "PJMEDIA Phase 3 SDP offer/answer validation"
	depends on PJPROJECT && PJLIB_UTIL && PJMEDIA_SDP_NEG
	depends on !PJMEDIA_ENDPOINT && !PJMEDIA_G711 && !PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Run deterministic offer/answer, rejection, state-transition, lifecycle,
	  configured-boundary, stack, and pool tests without a media runtime.

config PJMEDIA_PHASE3_LINK_PROBE
	bool "PJMEDIA Phase 3 whole negotiator API link probe"
	depends on PJPROJECT && PJLIB_UTIL && PJMEDIA_SDP_NEG
	depends on !PJMEDIA_ENDPOINT && !PJMEDIA_G711 && !PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Retain references to every public SDP-negotiator API in an independent
	  image to expose closure dependencies that normal section garbage
	  collection could otherwise discard.

config PJMEDIA_PHASE4_INVITE_TEST
	bool "PJMEDIA Phase 4 INVITE lifecycle validation"
	depends on PJPROJECT && PJSIP && PJSIP_INVITE && PJMEDIA_SDP_NEG
	depends on !PJMEDIA_ENDPOINT && !PJMEDIA_G711 && !PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Validate PJSIP INVITE, 100rel, and session-timer module lifecycle and
	  session creation without sockets, media runtime, codecs, or audio.

config PJMEDIA_PHASE5_LOOP_CALL_TEST
	bool "PJMEDIA Phase 5 loop call-control validation"
	depends on PJPROJECT && PJSIP && PJSIP_INVITE && PJMEDIA_SDP_NEG
	depends on !PJSIP_UDP_TRANSPORT && !PJSIP_TCP_TRANSPORT
	depends on !PJMEDIA_ENDPOINT && !PJMEDIA_G711 && !PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Validate socket-free INVITE call control, CANCEL, rejection, timeout,
	  transport failure, offerless INVITE, re-INVITE, SDP direction changes,
	  and complete teardown over PJSIP's in-memory loop transport. No RTP or
	  audio runtime is selected.

config PJMEDIA_PHASE6_UDP_CALL_TEST
	bool "PJMEDIA Phase 6 IPv4 UDP call-control validation"
	depends on PJPROJECT && PJSIP && PJSIP_INVITE && PJSIP_REGC
	depends on PJSIP_UDP_TRANSPORT && PJMEDIA_SDP_NEG
	depends on NET_SOCKETS && NET_IPV4 && NET_UDP && !NET_IPV6
	depends on !PJSIP_TCP_TRANSPORT
	depends on !PJMEDIA_ENDPOINT && !PJMEDIA_G711 && !PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Validate INVITE call control, UDP retransmission and failure handling,
	  registration and OPTIONS concurrency, and complete teardown over two
	  IPv4 loopback SIP transports. No RTP or audio runtime is selected.

config PJMEDIA_PHASE7_G711_TEST
	bool "PJMEDIA Phase 7 endpoint and G.711 validation"
	depends on PJPROJECT && PJSIP && PJMEDIA_ENDPOINT && PJMEDIA_G711
	depends on !PJSIP_INVITE && !PJSIP_UDP_TRANSPORT && !PJSIP_TCP_TRANSPORT
	depends on !PJMEDIA_SDP_NEG && !PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Validate a zero-worker PJMEDIA endpoint sharing the PJSIP ioqueue and
	  deterministic PCMU/PCMA codec conversion, PLC, VAD, and teardown. This
	  does not select RTP, media transport, stream, or audio-device runtime.

config PJMEDIA_PHASE7_LINK_PROBE
	bool "PJMEDIA Phase 7 public API link probe"
	depends on PJPROJECT && PJSIP && PJMEDIA_ENDPOINT && PJMEDIA_G711
	depends on !PJSIP_INVITE && !PJSIP_UDP_TRANSPORT && !PJSIP_TCP_TRANSPORT
	depends on !PJMEDIA_SDP_NEG && !PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Retain the Phase 7 endpoint, codec manager, G.711, conversion, PLC,
	  VAD, WSOLA, event, format, and port public API closure.

config PJMEDIA_PHASE8_PACKET_TEST
	bool "PJMEDIA Phase 8 RTP/RTCP/jitter-buffer validation"
	depends on PJPROJECT && PJMEDIA_ENDPOINT && PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_G711 && !PJMEDIA_SDP_NEG
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	depends on !PJSIP
	help
	  Validate deterministic RTP packet bounds and sequence state, RTCP
	  reports/statistics, and jitter-buffer behavior without sockets, media
	  transport, streams, codecs, PJSIP, or audio devices.

config PJMEDIA_PHASE8_LINK_PROBE
	bool "PJMEDIA Phase 8 public API link probe"
	depends on PJPROJECT && PJMEDIA_ENDPOINT && PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_G711 && !PJMEDIA_SDP_NEG
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	depends on !PJSIP
	help
	  Retain the supported RTP, RTCP, RTCP-feedback, and jitter-buffer public
	  API closure under the normal section garbage-collection policy.

config PJMEDIA_PHASE8_DISABLED_TEST
	bool "PJMEDIA Phase 8 feature-disabled marker"
	depends on PJPROJECT && PJMEDIA_ENDPOINT && !PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_G711 && !PJMEDIA_SDP_NEG
	depends on !PJMEDIA_UDP_TRANSPORT && !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	depends on !PJSIP
	help
	  Emit an explicit marker for the like-for-like profile in which the
	  Phase 8 RTP/RTCP/jitter-buffer production gate remains disabled.

config PJMEDIA_PHASE9_TRANSPORT_TEST
	bool "PJMEDIA Phase 9 loop and IPv4 UDP transport validation"
	depends on PJPROJECT && PJSIP && PJSIP_REGC && PJSIP_UDP_TRANSPORT
	depends on PJMEDIA_ENDPOINT && PJMEDIA_RTP_RTCP
	depends on PJMEDIA_LOOP_TRANSPORT && PJMEDIA_UDP_TRANSPORT
	depends on NET_SOCKETS && NET_IPV4 && NET_UDP && !NET_IPV6
	depends on !PJSIP_INVITE && !PJSIP_TCP_TRANSPORT
	depends on !PJMEDIA_G711 && !PJMEDIA_SDP_NEG
	depends on !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Validate socket-free loop transport first, then deterministic RTP and
	  RTCP callbacks over explicit IPv4 UDP loopback sockets sharing PJSIP's
	  ioqueue. Also validate detach/cancellation/destruction and signaling
	  coexistence without creating a media stream or audio device.

config PJMEDIA_PHASE9_LINK_PROBE
	bool "PJMEDIA Phase 9 public API link probe"
	depends on PJPROJECT && PJSIP && PJMEDIA_ENDPOINT && PJMEDIA_RTP_RTCP
	depends on PJMEDIA_LOOP_TRANSPORT && PJMEDIA_UDP_TRANSPORT
	depends on NET_SOCKETS && NET_IPV4 && NET_UDP && !NET_IPV6
	depends on !PJMEDIA_G711 && !PJMEDIA_SDP_NEG
	depends on !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV
	help
	  Retain the public loop and UDP media transport API closure under the
	  normal section garbage-collection policy.

config PJMEDIA_PHASE9_DISABLED_TEST
	bool "PJMEDIA Phase 9 feature-disabled marker"
	depends on PJPROJECT && PJMEDIA_ENDPOINT && PJMEDIA_RTP_RTCP
	depends on !PJMEDIA_LOOP_TRANSPORT && !PJMEDIA_UDP_TRANSPORT
	depends on !PJMEDIA_G711 && !PJMEDIA_SDP_NEG
	depends on !PJMEDIA_STREAM && !PJMEDIA_AUDIODEV && !PJSIP
	help
	  Emit an explicit marker for the like-for-like profile in which both
	  Phase 9 media transport production gates remain disabled.

endmenu

source "Kconfig.zephyr"

menu "PJSIP minimal application validation"

config PJSIP_PHASE3_TEST
	bool "PJSIP Phase 3 PJLIB-UTIL validation"
	depends on PJPROJECT && PJLIB_UTIL
	depends on !PJSIP
	help
	  Build the focused initialization, scanner, string escaping, and MD5
	  validation for the initial four-source PJLIB-UTIL subset. PJSIP remains
	  disabled so this test cannot accidentally cross the Phase 4 boundary.

config PJSIP_PHASE4_TEST
	bool "PJSIP Phase 4 core compile/link validation"
	depends on PJPROJECT && PJSIP
	help
	  Include the public PJSIP umbrella header and validate the explicit
	  Zephyr core configuration. Endpoint creation and transport runtime tests
	  remain outside this compile/link-only phase.

config PJSIP_PHASE5_TEST
	bool "PJSIP Phase 5 parser/message/endpoint validation"
	depends on PJPROJECT && PJSIP
	help
	  Run deterministic URI, message, multipart, authentication, transmit-data,
	  module, and repeated endpoint lifecycle tests without socket transports.

config PJSIP_PHASE6_TEST
	bool "PJSIP Phase 6 event loop/loop transport/transaction validation"
	depends on PJPROJECT && PJSIP
	help
	  Run deterministic endpoint polling, timer, loop-datagram transport, and
	  UAC/UAS transaction state-machine tests without socket transports.

config PJSIP_PHASE7_TEST
	bool "PJSIP Phase 7 IPv4 UDP transport validation"
	depends on PJPROJECT && PJSIP && PJSIP_UDP_TRANSPORT
	help
	  Run deterministic IPv4 UDP-loopback transport, malformed datagram,
	  ioqueue-capacity, and UAC/UAS transaction tests without Internet access.

config PJSIP_PHASE8_TEST
	bool "PJSIP Phase 8 IPv4 TCP transport validation"
	depends on PJPROJECT && PJSIP && PJSIP_TCP_TRANSPORT
	depends on PJSIP_UDP_TRANSPORT
	help
	  Run deterministic IPv4 TCP-loopback listener, framing, connection,
	  reconnect, and UAC/UAS transaction tests alongside UDP transport.

config PJSIP_PHASE9_TEST
	bool "PJSIP Phase 9 deterministic SIP resolution validation"
	depends on PJPROJECT && PJSIP && PJSIP_UDP_TRANSPORT
	depends on PJLIB_UTIL_DNS_RESOLVER
	help
	  Run deterministic IPv4 A and SIP SRV resolution, failure, timeout,
	  cancellation, resolver destruction, and resolved-transport tests against
	  an application-local DNS responder without Internet access.

config PJSIP_PHASE10_TEST
	bool "PJSIP Phase 10 usable signaling and registration validation"
	depends on PJPROJECT && PJSIP && PJSIP_REGC
	depends on PJSIP_UDP_TRANSPORT
	help
	  Register with an application-local registrar, complete Digest challenge
	  handling, refresh and unregister, validate invalid credentials and
	  timeout recovery, exchange OPTIONS, and shut down cleanly.

endmenu

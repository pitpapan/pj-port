source "Kconfig.zephyr"

menu "VoIP integration validation"

config VOIP_CORE_SERVICE_TEST
	bool "PJ-independent core service validation"
	depends on VOIP_SERVICE && VOIP_SERVICE_FAKE_ADAPTER
	default n

config VOIP_SDK_CONTRACT_TEST
	bool "Production SDK contract validation"
	depends on VOIP_SDK && VOIP_FAKE_BACKEND

config VOIP_PHASE1_TEST
	bool "Phase 1 facade validation"
	depends on VOIP_FACADE && VOIP_FAKE_BACKEND

config VOIP_PHASE2_RUNTIME_TEST
	bool "Phase 2 shared runtime validation"
	depends on VOIP_FACADE && VOIP_PJ_BACKEND

config VOIP_PHASE3_ACCOUNT_TEST
	bool "Phase 3 single-account validation"
	depends on VOIP_FACADE && VOIP_PJ_BACKEND && PJSIP_REGC

config VOIP_PHASE4_REGISTRATION_TEST
	bool "Phase 4 TCP registration validation"
	depends on VOIP_FACADE && VOIP_PJ_BACKEND && PJSIP_REGC && PJSIP_TCP_TRANSPORT

config VOIP_PHASE5_CALL_TEST
	bool "Phase 5 one-call TCP validation"
	depends on VOIP_PJ_CALL_CONTROL

config VOIP_PHASE6_MEDIA_TEST
	bool "Phase 6 headless G.711 media validation"
	depends on VOIP_PJ_HEADLESS_MEDIA

config VOIP_PHASE7_SIP_MEDIA_TEST
	bool "Phase 7 SIP-controlled headless media validation"
	depends on VOIP_PJ_CALL_CONTROL && VOIP_PJ_HEADLESS_MEDIA

config VOIP_PHASE8_HOLD_RECOVERY_TEST
	bool "Phase 8 hold and recovery validation"
	depends on VOIP_PJ_CALL_CONTROL && VOIP_PJ_HEADLESS_MEDIA

config VOIP_PHASE9_ROBUSTNESS_TEST
	bool "Phase 9 robustness and resource qualification"
	depends on VOIP_PJ_CALL_CONTROL && VOIP_PJ_HEADLESS_MEDIA

config VOIP_SRTP_KEY_TEST
	bool "SRTP per-call key lifecycle validation"
	depends on VOIP_PJ_SRTP_KEY_LIFECYCLE

config VOIP_SRTP_CALL_TEST
	bool "SIP-controlled mandatory SRTP/SDES call validation"
	depends on VOIP_PJ_SRTP_SIGNALING

config VOIP_PJSUA_LINK_TEST
	bool "PJSUA-LIB link closure validation"
	depends on PJSUA

config VOIP_PJSUA_ARENA_TEST
	bool "PJSUA bounded pool arena validation"
	depends on PJSUA

config VOIP_PJSUA_CAPACITY_TEST
	bool "PJSUA account and call capacity validation"
	depends on PJSUA && PJSIP_INVITE && PJSIP_TCP_TRANSPORT

config VOIP_SIP_TLS
	bool "VoIP SIP TLS"
	depends on PJSIP
	default n
	help
	  Reserved signaling-security policy gate; TLS remains disabled in the
	  initial PJSUA-LIB profile.

config VOIP_SRTP
	bool "VoIP SRTP media"
	depends on PJMEDIA
	default n
	help
	  Reserved media-security policy gate; SRTP remains disabled in the
	  initial PJSUA-LIB profile.

endmenu
